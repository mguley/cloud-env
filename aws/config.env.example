# Copy to aws/config.env, edit, then export from the repository root:
# set -a; source aws/config.env; set +a
# Keep aws/config.env, .state/, AWS credentials and private keys private.

# Optional named profile; omit when using the automation host's IAM role.
# AWS_PROFILE=k8s-admin

AWS_REGION=us-east-1
AWS_EXPECTED_ACCOUNT_ID=your-12-digit-account-id
AWS_CLUSTER_NAME=k8s-cluster

# Empty selects the first available standard AZ offering AWS_INSTANCE_TYPE.
# Offerings do not guarantee available capacity. No automatic AZ retry.
AWS_AVAILABILITY_ZONE=
AWS_INSTANCE_TYPE=t3.medium
AWS_ARCH=amd64
AWS_DISK_SIZE_GB=30

# Empty discovers the latest official Canonical Ubuntu Server 24.04 LTS AMI.
AWS_AMI_ID=

AWS_VPC_CIDR=172.20.0.0/16
AWS_SUBNET_CIDR=172.20.1.0/24
AWS_CP_PRIVATE_IP=172.20.1.10
AWS_WORKER_PRIVATE_IP=172.20.1.11

# Required: one trusted SSH source IPv4 CIDR, normally the automation host's
# public egress address followed by /32. A /0 is rejected.
AWS_ADMIN_CIDR=
AWS_SSH_KEY="$HOME/.ssh/${AWS_CLUSTER_NAME}_aws_ed25519"

# Used only for t2/t3/t3a/t4g. Standard can throttle when credits run out;
# unlimited can incur surplus CPU credit charges.
AWS_CPU_CREDITS=standard

# No automatic expiration. Use aws/delete-vms.sh for intentional cleanup.
