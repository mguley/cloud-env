# Copy to gcp/config.env, edit, then export with:
# set -a; source gcp/config.env; set +a
# Keep your config.env and .state/ directory private.

PROJECT_ID=your-project-id
CLUSTER_NAME=k8s-cluster
REGION=us-central1

# Optional ordered zones within REGION; empty discovers supported UP zones.
ZONES=
MAX_ATTEMPTS=3

SUBNET_RANGE=172.16.0.0/20
CP_INTERNAL_IP=172.16.0.2
WORKER_INTERNAL_IP=172.16.0.3
MACHINE_TYPE=e2-standard-2
DISK_SIZE_GB=30
IMAGE_PROJECT=ubuntu-os-cloud
IMAGE_FAMILY=ubuntu-2404-lts-amd64

# Required: public egress IPv4 of the automation host, typically x.x.x.x/32.
# Use comma-separated CIDRs for multiple trusted SSH sources. No /0.
ADMIN_CIDRS=
SSH_USER=k8sadmin
SSH_KEY="$HOME/.ssh/${CLUSTER_NAME}_ed25519"

# Empty keeps VMs running until explicitly stopped or deleted.
# Setting a duration such as 6h enables automatic VM AND boot-disk deletion.
VM_MAX_RUN_DURATION=
